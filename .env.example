# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so it never gets committed. Never paste a key in the group chat.

# 1. Claude Console -> API keys  (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 2. Who answers Ask questions. Leave it on claude.
#    lumen = Lumen AI Chat answers instead (the host's demo; needs the Lumen settings below).
#    Quiz mode always runs on Claude with your local notes.
NOTES_BACKEND=claude

# 3. Lumen AI Chat (host only; attendees leave these blank)
#    Key and secret: Organization Portal -> Settings -> API Keys, with the AI Chat grant.
#    Instance IDs: python reviewer.py instances
LUMEN_BASE_URL=https://api.staging.nonlive.lumen.bayanichain.tech
LUMEN_API_KEY=
LUMEN_API_SECRET=
LUMEN_INSTANCE_BIO=
LUMEN_INSTANCE_ECON=
LUMEN_INSTANCE_PH_HISTORY=

# Optional: another Claude model
# REVIEWER_MODEL=claude-sonnet-5-5
