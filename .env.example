# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so it never gets committed. Never paste a key in the group chat.

# 1. Claude Console -> API keys  (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 2. Who answers Ask questions. Leave it on claude.
#    lumen = Lumen AI Chat answers instead (MODULE §7; needs the Lumen settings below).
#    Or switch for one command: python reviewer.py ask "..." --backend lumen
#    Quiz mode always runs on Claude with your local notes.
NOTES_BACKEND=claude

# 3. Lumen AI Chat: the host sends you the key, the secret and the three instance IDs.
#    Each Lumen question costs 5 credits. (Hosts: Organization Portal -> Settings -> API Keys,
#    with the AI Chat grant; list instance IDs with: python reviewer.py instances)
LUMEN_BASE_URL=https://api.staging.nonlive.lumen.bayanichain.tech
LUMEN_API_KEY=
LUMEN_API_SECRET=
LUMEN_INSTANCE_BIO=
LUMEN_INSTANCE_ECON=
LUMEN_INSTANCE_PH_HISTORY=

# Optional: another Claude model
# REVIEWER_MODEL=claude-sonnet-5-5
